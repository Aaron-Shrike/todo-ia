# Copy to `.env` before running `docker compose up`. Every variable here maps
# 1:1 to the `Settings` class (services/api/src/app/platform/settings.py) and
# to the Configuration table in openspec/changes/phrase-validation/design.md.
# docker-compose.yml supplies the same defaults via `${VAR:-default}`
# interpolation, so the stack runs even before this file is copied — copying
# it to `.env` only lets you override these defaults. Two image-fixed vars
# (HF_HUB_OFFLINE/TRANSFORMERS_OFFLINE, SENTENCE_TRANSFORMERS_HOME) are baked
# into the API image and are intentionally NOT listed here.

# --- Database ---
DATABASE_URL=postgresql+psycopg://todo_ia:todo_ia@db:5432/todo_ia
POSTGRES_USER=todo_ia
POSTGRES_PASSWORD=todo_ia
POSTGRES_DB=todo_ia

# --- Domain policy ---
# Cosine score >= SIMILARITY_THRESHOLD is a duplicate (inclusive boundary). 0 <= t <= 1.
# Working default, calibrated in docs/evidence/calibration.md against the real model.
SIMILARITY_THRESHOLD=0.80
# Max accepted `limit` for POST /phrases/matches (and the page size used there). 1..200.
MATCHES_PAGE_SIZE=50
# Max phrase length in code points after normalization. Raw pre-normalization
# cap is 4x this value. 1..4000.
PHRASE_MAX_LENGTH=280
# Max `?limit=` a client may request on GET /phrases. 1..1000.
PHRASES_LIST_LIMIT=200
# Default page size for GET /phrases when `?limit=` is omitted. 1..1000.
PHRASES_PAGE_SIZE=10
# Reject request bodies above this size (bytes) with 413, before parsing. >= 4096.
MAX_REQUEST_BYTES=1048576

# --- Embeddings ---
# Runtime enum has ONE value; `fake` exists only in the test settings class.
EMBEDDING_PROVIDER=senten
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 40-hex Hugging Face Hubaked with (verified, Unit8).
# Also a Docker build ARGge was actually built with.
EMBEDDING_MODEL_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
# Must equal both the prond the `vector(n)` column
# typmod — checked at boot, the app refuses to start on a mismatch.
EMBEDDING_DIMENSIONS=384
EMBEDDING_TIMEOUT_SECONDS=10.0
# Executor size and semapdingProvider. >= 1.
EMBEDDING_MAX_CONCURRENCY=2
# Bounded LRU cache size  decorator. 0 disablescaching entirely.
EMBEDDING_CACHE_SIZE=512
# HNSW ef_search for the validate endpoint's unfiltered top-1 find_nearest
only. 1..1000.
HNSW_EF_SEARCH=200

# --- Concurrency ---
# Bounds the wait for thevisory_xact_lock), inmilliseconds.
LOCK_TIMEOUT_MS=5000

# --- API / platform ---
# Comma-separated absolute origins, no wildcard.
CORS_ORIGINS=http://local
LOG_LEVEL=INFO

# --- Web (Next.js) ---
# Browser-facing build arternally reachable URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Build arg; UI character to PHRASE_MAX_LENGTH.
NEXT_PUBLIC_PHRASE_MAX_LENGTH=280
# Server-side fetch (Servves inside the composenetwork.
API_INTERNAL_URL=http://a